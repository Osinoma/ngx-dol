message: "If you use this dataset, please cite it as below."
type: dataset
title: "NGX-DOL: an open daily panel of the Nigerian equity market, 2014-2026"
version: "1.0.0"
date-released: "2026-10-30"
authors:
  - family-names: "Amhanesi"
    given-names: "John"
    orcid: "https://orcid.org/0009-0003-5520-3403"
    affiliation: "Independent Researcher, New York, USA"
